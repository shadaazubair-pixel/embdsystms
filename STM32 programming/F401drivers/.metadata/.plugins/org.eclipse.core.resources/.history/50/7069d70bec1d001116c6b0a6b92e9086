#include "stm32f401xx_spi_driver.h"
#include "stm32f401xx.h"

void SPI_PeriClockControl(SPI_RegDef_t *pSPIx, uint8_t  EnorDi)
{
	if(EnorDi==1)
	{
		if(pSPIx == SPI1)
		{
			SPI1_PCLK_EN();
		}

		else if(pSPIx == SPI2)
		{
			SPI2_PCLK_EN();
		}
		else if(pSPIx == SPI3)
		{
			SPI3_PCLK_EN();

		}
		else if(pSPIx == SPI4)
		{
			SPI4_PCLK_EN();
		}
	}

	else
	{
		if(pSPIx == SPI1)
	{
		SPI1_PCLK_DI();
	}

	else if(pSPIx == SPI2)
	{
		SPI2_PCLK_DI();
	}
	else if(pSPIx == SPI3)
	{
		SPI3_PCLK_DI();

	}
	else if(*pSPIx == SPI4)
	{
		SPI4_PCLK_DI();
	}

	}
}


